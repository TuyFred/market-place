PORT=4000
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Local: * | Production: https://afroluxo.com (comma-separated OK)
CORS_ORIGIN=*
FRONTEND_URL=http://localhost:5173
# Brevo (Sendinblue) — password reset emails
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=AFROLUXO BY ASI
# Server-only bootstrap admin (used by: npm run seed-admin) — never put these in VITE_*
ADMIN_EMAIL=admin@system.com
ADMIN_PASSWORD=admin123@
